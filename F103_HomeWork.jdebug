/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.AddPathSubstitute ("C:/Users/13588/Desktop/learning/programing/STM32/F103_HomeWork", "$(ProjectDir)");
  Project.AddPathSubstitute ("c:/users/13588/desktop/learning/programing/stm32/f103_homework", "$(ProjectDir)");
  Project.SetDevice ("STM32F103C8");
  Project.SetHostIF ("USB", "1040348510");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("1 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M3.svd");
  Project.AddSvdFile ("$(InstallDir)/Config/Peripherals/STM32F103xx.svd");
  //
  // User settings
  //
  File.Open ("$(ProjectDir)/build/F103_HomeWork.elf");
}

